# ─── Database (Prisma) ─────────────────────────────────────────────────────────
# Settings → Database → Connection string.
# DATABASE_URL: "Transaction pooler" (port 6543) — what Prisma uses at request time.
# DIRECT_URL:   "Direct connection" (port 5432) — used for migrations, and for
#               the LISTEN/NOTIFY connection in lib/realtime.ts, which needs a
#               connection the pooler can't provide (see the comment there).
DATABASE_URL="postgresql://postgres.zrcgvttbxtkixpxrdzis:DAlxmurkLumkU1M3@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=3&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.zrcgvttbxtkixpxrdzis:DAlxmurkLumkU1M3@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# ─── Storage ────────────────────────────────────────────────────────────────
